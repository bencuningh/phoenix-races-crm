# Notion — create an internal integration at https://notion.so/my-integrations,
# share it with the "Phoenix Races — Contacts" database, and paste its secret below.
NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=3c67e680-19aa-8025-920d-000b3847af13

# Supabase — Settings > API on the phoenix-races-crm project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth client (Gmail readonly) — console.cloud.google.com > APIs & Services > Credentials.
# Redirect URI must exactly match what's registered on the OAuth client, e.g.
# https://<your-vercel-deployment>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Anthropic API key — console.anthropic.com — powers the on-demand follow-up draft generator.
ANTHROPIC_API_KEY=

# Random string of your choosing — also set as the Vercel Cron Job's expected secret.
CRON_SECRET=

# Optional, defaults to 12.
FOLLOWUP_THRESHOLD_DAYS=12
